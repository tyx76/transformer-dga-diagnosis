# ---- 虚拟环境 ----
venv/
env/
.venv/

# ---- Python 缓存 ----
__pycache__/
*.pyc
*.pyo

# ---- 密钥/环境变量（极其重要，绝不提交）----
.env
.env.local

# ---- 本地数据库 / 向量库 ----
chroma_db/
*.sqlite3

# ---- 版权/大体积资料（本地保留，不入库）----
