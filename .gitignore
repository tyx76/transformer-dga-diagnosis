literature/
source_materials/
club_assessment_problem.pdf
data/corpus/clauses.jsonl
data/corpus/*.txt
!data/corpus/DLT-722-2014_criteria_tables.txt

# ---- IDE / 系统 ----
.idea/
.vscode/
.DS_Store
# ---- 待审核的成员提交（大文件/第三方产物，不入库）----
submissions_pending_review/

# ---- 第三方原始数据文件（不再分发，仅本地保留）----
data/samples/*.xlsx
data/samples/*.xls

# ---- 向量知识库（本地保留，不入库）----
vector_kb/knowledge.db
vector_kb/knowledge.db-*
